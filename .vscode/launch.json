<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>😤 Anger Dump</title>


  <style>

    /* ========================================
       RESET
    ======================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    /* ========================================
       VARIABLES
    ======================================== */

    :root {
      --red: #ff4757;
      --dark-red: #e84118;
      --orange: #ff9f43;
      --green: #2ed573;
      --purple: #9b59b6;
      --blue: #3498db;

      --dark: #080808;
      --card: #171717;
      --card2: #222;

      --text: #ffffff;
      --muted: #aaaaaa;
    }


    /* ========================================
       BODY
    ======================================== */

    body {

      min-height: 100vh;

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      color: var(--text);

      text-align: center;

      background:
        radial-gradient(
          circle at top,
          #351010 0%,
          #111 35%,
          #050505 100%
        );

      overflow-x: hidden;

      transition:
        background-color .3s ease;
    }


    /* ========================================
       HEADER
    ======================================== */

    header {
      padding: 35px 20px 20px;
    }


    .logo {

      font-size: 55px;

      animation:
        angry 1.2s infinite alternate;

    }


    @keyframes angry {

      from {
        transform:
          rotate(-5deg)
          scale(1);
      }

      to {
        transform:
          rotate(5deg)
          scale(1.08);
      }

    }


    h1 {

      font-size:
        clamp(35px, 8vw, 65px);

      margin: 5px 0;

      font-weight: 900;

      background:
        linear-gradient(
          90deg,
          #ff4757,
          #ff9f43,
          #ff4757
        );

      background-size: 200%;

      color: transparent;

      background-clip: text;
      -webkit-background-clip: text;

      animation:
        gradient 3s linear infinite;

    }


    @keyframes gradient {

      0% {
        background-position: 0%;
      }

      100% {
        background-position: 200%;
      }

    }


    header p {

      color: var(--muted);

      font-size: 16px;

      margin-top: 8px;

    }


    /* ========================================
       UPLOAD
    ======================================== */

    .upload-area {

      margin: 20px auto;

      padding:
        0 20px;

    }


    input[type="file"] {
      display: none;
    }


    .upload-label {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 10px;

      padding:
        15px 25px;

      background:
        linear-gradient(
          135deg,
          var(--red),
          var(--dark-red)
        );

      border-radius: 14px;

      cursor: pointer;

      font-size: 17px;

      font-weight: bold;

      box-shadow:
        0 8px 25px
        rgba(255, 71, 87, .3);

      transition: .25s;

    }


    .upload-label:hover {

      transform:
        translateY(-3px)
        scale(1.03);

      box-shadow:
        0 12px 35px
        rgba(255, 71, 87, .45);

    }


    /* ========================================
       GAME
    ======================================== */

    #game {

      display: none;

      width:
        min(95%, 900px);

      margin:
        25px auto
        50px;

    }


    .game-card {

      background:
        rgba(23, 23, 23, .9);

      border:
        1px solid #333;

      border-radius: 25px;

      padding: 25px;

      box-shadow:
        0 20px 70px
        rgba(0, 0, 0, .5);

      backdrop-filter:
        blur(10px);

    }


    /* ========================================
       STATS
    ======================================== */

    .stats {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 12px;

      margin-bottom: 20px;

    }


    .stat {

      background:
        var(--card2);

      border-radius: 15px;

      padding:
        15px 8px;

      border:
        1px solid #333;

    }


    .stat-value {

      display: block;

      font-size: 25px;

      font-weight: bold;

      color:
        var(--orange);

    }


    .stat-label {

      color: #888;

      font-size: 12px;

      text-transform:
        uppercase;

    }


    /* ========================================
       PHOTO
    ======================================== */

    #photoBox {

      width:
        min(100%, 500px);

      height:
        min(70vw, 500px);

      min-height: 280px;

      margin: auto;

      border-radius: 22px;

      overflow: hidden;

      background: #111;

      position: relative;

      border:
        3px solid #444;

      box-shadow:
        0 0 0 5px
        rgba(255, 71, 87, .05),

        0 15px 50px
        rgba(0, 0, 0, .6);

    }


    #photo {

      width: 100%;

      height: 100%;

      object-fit: cover;

      display: block;

    }


    /* ========================================
       HIT EMOJI
    ======================================== */

    #emoji {

      position: absolute;

      font-size:
        clamp(55px, 12vw, 100px);

      display: none;

      pointer-events: none;

      z-index: 10;

      filter:
        drop-shadow(
          0 5px 5px
          rgba(0, 0, 0, .5)
        );

    }


    .hit-animation {

      animation: